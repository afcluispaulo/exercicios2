programa
{
	//DICA: na estrutura de Condições Múltiplas pode ser usado caractere, mas NÃO pode ser usado cadeia de caractere (cadeia).
	
	funcao inicio()
	{
		inteiro num
		escreva("Digite uma letra qualquer: ")
		leia(let)
		escolha(let)
		{
			caso 'a':
				escreva(" Um ")
				pare
			caso 2:
				escreva(" Dois ")
				pare
			caso 3:
				escreva(" Três ")
				pare
			caso 4:
				escreva(" Quatro ")
				pare
			caso contrario:
				escreva(" Erro " )
				pare
		}
		escreva("\n FIM DO PROCESSAMENTO ")
	}
}
