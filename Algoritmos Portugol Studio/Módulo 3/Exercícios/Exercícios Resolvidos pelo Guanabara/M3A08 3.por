programa
{
	
	funcao inicio()
	{
		// Nunca se declara uma variável dentro de uma REPETIÇÃO.

		inteiro n
		caracter r
		enquanto (verdadeiro) 
		{
			escreva("Valor: ")
			leia(n)

			escreva("Quer continuar? ")
			leia(r)
			se (r == 'N'ou r == 'n')
			{
				pare
			}
		}
	}
}
