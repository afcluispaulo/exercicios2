programa
{
	/*
		 	Exercício 001 - Programa para dar boas-vindas ao usuário.
		 	Autor: Gustavo Guanabara.
		 	Empresa: Estudonauta.
	*/
	
	funcao inicio()
	{
		//Declaração de variável
		cadeia nome //Vai guardar o nome do usuário.
		
		// inteiro a, b, c //errado
		// inteiro n1, n2, s //mais organizado!

		//Entrada de dados
		escreva("Olá! Qual é o seu nome? ")
		leia (nome)

		//Resultados finais
		escreva("Tudo bem, " + nome + " ? É um grande prazer te conhecer!" )
	}
}
