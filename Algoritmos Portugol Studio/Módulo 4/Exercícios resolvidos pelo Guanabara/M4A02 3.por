programa
{
	funcao inicio()
	{
		inteiro idade[4]
		para (inteiro pos = 0; pos < 4; pos++) {
			escreva("Digite uma idade: ")
			leia(idade[pos])
		}
		escreva("FIM")

		escreva("As idades digitadas foram: ")
		
		para (inteiro pos = 0; pos < 4; pos++) {
			escreva(idade[pos])
		}
		
	}
}
